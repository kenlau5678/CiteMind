# Required for question answering. Files and embeddings remain local; only the
# question and retrieved evidence excerpts are sent to this API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Visual questions inspect at most one relevant original PDF page. The first
# inspection is cached locally; ordinary text questions do not call these models.
OPENAI_VISION_INDEX_MODEL=gpt-5.6-luna
OPENAI_VISION_ANSWER_MODEL=gpt-5.6-terra
CITEMIND_VISION_MAX_PAGES=1
# Cost guard for image-only pages transcribed during one PDF upload.
CITEMIND_SCAN_MAX_PAGES=50

# Downloaded once and run locally (about 220 MB).
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
